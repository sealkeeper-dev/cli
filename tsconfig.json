{
  "compilerOptions": {
    "strict": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "types", "tsup.config.ts", "vitest.config.ts"]
}
