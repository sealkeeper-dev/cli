{
  "name": "sealkeeper",
  "version": "0.6.2",
  "description": "The SealKeeper CLI. A cryptographic identity and verifiable track record for AI agents.",
  "keywords": [
    "ai-agents",
    "agent-identity",
    "ed25519",
    "claude-code",
    "mastra",
    "cli"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/sealkeeper-dev/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sealkeeper-dev/cli.git"
  },
  "bugs": {
    "url": "https://github.com/sealkeeper-dev/cli/issues"
  },
  "type": "module",
  "bin": {
    "sealkeeper": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./types/lib.d.ts",
      "default": "./dist/lib.js"
    },
    "./mastra": {
      "types": "./types/mastra.d.ts",
      "default": "./dist/mastra.js"
    },
    "./openclaw": {
      "types": "./types/openclaw.d.ts",
      "default": "./dist/openclaw.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./types/lib.d.ts",
  "openclaw": {
    "extensions": [
      "./dist/openclaw.js"
    ]
  },
  "files": [
    "dist",
    "types",
    "openclaw.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-LICENSES"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@noble/ed25519": "^3.2.0",
    "@sealkeeper/schema": "^0.6.1",
    "@types/node": "^22.20.5",
    "commander": "^15.0.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
