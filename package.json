{
  "name": "sealkeeper",
  "version": "0.4.4",
  "description": "The SealKeeper CLI. A cryptographic identity and verifiable track record for AI agents.",
  "keywords": [
    "ai-agents",
    "agent-identity",
    "ed25519",
    "claude-code",
    "mastra",
    "cli"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/sealkeeper-dev/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sealkeeper-dev/cli.git"
  },
  "bugs": {
    "url": "https://github.com/sealkeeper-dev/cli/issues"
  },
  "type": "module",
  "bin": {
    "sealkeeper": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./types/lib.d.ts",
      "default": "./dist/lib.js"
    },
    "./mastra": {
      "types": "./types/mastra.d.ts",
      "default": "./dist/mastra.js"
    },
    "./openclaw": {
      "types": "./types/openclaw.d.ts",
      "default": "./dist/openclaw.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./types/lib.d.ts",
  "openclaw": {
    "extensions": [
      "./dist/openclaw.js"
    ]
  },
  "files": [
    "dist",
    "types",
    "openclaw.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "prepublishOnly": "node -e \"if(!process.env.GITHUB_CLIENT_ID){console.error('set GITHUB_CLIENT_ID to publish, or init cannot sign in');process.exit(1)}\" && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@noble/ed25519": "^3.2.0",
    "commander": "^15.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@sealkeeper/schema": "^0.4.2",
    "@types/node": "^22.20.4",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
